<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TUIKit</PackageId>
    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <FileVersion>1.8.0.0</FileVersion>
    <Title>TUIKit — concurrent terminal UI framework for .NET</Title>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>TUIKit</Product>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <Description>A concurrency-first terminal UI framework for .NET. Compose multi-pane console apps with a developer-defined region layout, thread-safe pane writes, streaming Markdown and inline markup, correct Unicode width and grapheme handling, double-buffered diff rendering, enhanced keyboard input, SGR mouse and OSC 8 links, modal dialogs and toast notifications, and a broad widget toolkit — tables, trees, tabs, forms, menus, a fuzzy finder, charts (braille/line/bar/box-plot/histogram/heat-map), gauges and progress, a color picker, a file browser, a diff viewer, syntax highlighting, banners, and half-block/sixel/kitty image output. Includes reactive data binding, tick-driven animation, theming, and a headless backend for deterministic tests. Multi-targets netstandard2.0, net8.0, and net10.0. Stable release line following semantic versioning.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/jchristn/TUIKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/TUIKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageTags>tui;focus;accessibility;keyboard;opentelemetry;telemetry;metrics;tracing;terminal;console;ui;ansi;vt;tui-framework;widgets;layout;curses;ncurses;spectre;terminal-gui;charts;sixel;markdown;figlet;ascii-art;banner</PackageTags>
    <PackageReleaseNotes>v1.8.0 - Text entry and data for real apps. TextField gains opt-in shell line-editing keys (Ctrl+A/E/U/K/W, Ctrl+Left/Right), a prefilled value the first key replaces (SelectAll), a reveal key for masked values, Enter to submit (Submitted), a grapheme length limit (MaxLength), and validation (Validator, Validate, Error). Pastes can reach the focused widget (IPasteTarget, TuiApplication.RoutePasteToFocus, DialogModal.PasteTarget). FuzzyList becomes a full picker: detail text, disabled items, multi-select, an items provider, Enter to choose, paste, line-editing keys, and theme styles. DataTable pages locally or one server page at a time (PagingMode, BindPage, PageRequested) with a paging bar, load and error states, retry, marks across pages, and DataTableLoader for the async plumbing; columns gain stable keys, visibility, a chooser, and a keyboard column cursor. Additive; new behavior is opt-in, and the few visible changes are listed under Changed. Full release history: https://github.com/jchristn/TUIKit/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ascii\Fonts\Data\*.flf" />
    <None Include="Ascii\Fonts\Data\LICENSE.figlet.txt" Pack="true" PackagePath="fonts\" />
    <None Include="Ascii\Fonts\Data\REMOVED.txt" Pack="true" PackagePath="fonts\" />
  </ItemGroup>

</Project>
