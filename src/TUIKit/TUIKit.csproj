<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TUIKit</PackageId>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <Title>TUIKit — concurrent terminal UI framework for .NET</Title>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Product>TUIKit</Product>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <Description>A concurrency-first terminal UI framework for .NET. Compose multi-pane console apps with a developer-defined region layout, thread-safe pane writes, streaming Markdown and inline markup, correct Unicode width and grapheme handling, double-buffered diff rendering, enhanced keyboard input, SGR mouse and OSC 8 links, modal dialogs and toast notifications, and a broad widget toolkit — tables, trees, tabs, forms, menus, a fuzzy finder, charts (braille/line/bar/box-plot/histogram/heat-map), gauges and progress, a color picker, a file browser, a diff viewer, syntax highlighting, banners, and half-block/sixel/kitty image output. Includes reactive data binding, tick-driven animation, theming, and a headless backend for deterministic tests. Multi-targets netstandard2.0, net8.0, and net10.0. Stable release line following semantic versioning.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/jchristn/TUIKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/TUIKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageTags>tui;focus;accessibility;keyboard;opentelemetry;telemetry;metrics;tracing;terminal;console;ui;ansi;vt;tui-framework;widgets;layout;curses;ncurses;spectre;terminal-gui;charts;sixel;markdown;figlet;ascii-art;banner</PackageTags>
    <PackageReleaseNotes>v1.7.0 - MarkdownView for real apps. The view scrolls from the keyboard (Up/Down, PageUp/PageDown, Home/End) with key hints, and is focusable with an opt-in Tab stop (IsFocusStop). UseThemeStyles makes it follow the app theme without painting theme backgrounds, and MarkdownRenderOptions.WithTheme and MarkdownStyles.FromTheme(theme, includeBackgrounds) do the same for direct renders, with ASCII glyphs on ASCII themes. SetSearch, FindNext, FindPrevious, and F3 search the rendered text, highlighted with the new Theme.SearchMatchRole (Pane follows it too). TailFollow keeps a growing document at its end with a new-below indicator. MarkdownRenderer.StreamingPrefix exposes the rule that holds back half-received table rows and unconfirmed headers while a reply streams, and MarkdownLayoutCache caches layouts for apps that draw Markdown in their own widgets. Additive; new behavior is opt-in, and the few visible changes are listed under Changed. Full release history: https://github.com/jchristn/TUIKit/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ascii\Fonts\Data\*.flf" />
    <None Include="Ascii\Fonts\Data\LICENSE.figlet.txt" Pack="true" PackagePath="fonts\" />
    <None Include="Ascii\Fonts\Data\REMOVED.txt" Pack="true" PackagePath="fonts\" />
  </ItemGroup>

</Project>
